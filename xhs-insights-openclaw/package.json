{
  "name": "xhs-insights-openclaw-plugin",
  "version": "0.1.10",
  "description": "Social media research and marketing research for Xiaohongshu, XHS, RedNote, and 小红书: search notes, analyze comments, read note details, replies, creator profiles, and creator posts through a hosted read-only MCP service.",
  "main": "index.js",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Social Insights Assistant",
    "url": "https://52choujiang.com/assistant"
  },
  "homepage": "https://52choujiang.com/assistant",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "openclaw-plugin",
    "openclaw",
    "mcp",
    "xiaohongshu",
    "小红书",
    "xhs",
    "rednote",
    "social-insights",
    "social-media-research",
    "notes",
    "comments",
    "creator-profiles",
    "creator-posts",
    "marketing-research",
    "comment-analysis"
  ],
  "openclaw": {
    "kind": "plugin",
    "manifest": "openclaw.plugin.json",
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.0.0"
    },
    "build": {
      "openclawVersion": "2026.5.9"
    },
    "runtimeRequirements": {
      "bins": [
        "node"
      ],
      "env": [
        "SOCIAL_MEDIA_MCP_API_KEY"
      ],
      "primaryEnv": "SOCIAL_MEDIA_MCP_API_KEY",
      "networkTargets": [
        "https://mcp.52choujiang.com"
      ]
    },
    "environment": {
      "binaries": [
        "node"
      ],
      "externalServices": [
        {
          "name": "mcp.52choujiang.com"
        }
      ]
    },
    "configUiHints": {
      "apiKeyEnv": {
        "label": "API Key environment variable",
        "help": "Name of the environment variable that stores the Social Media MCP API Key.",
        "sensitive": false
      },
      "endpointUrl": {
        "label": "Endpoint URL",
        "help": "Hosted XHS Insights MCP endpoint."
      },
      "connectionTimeoutMs": {
        "label": "Connection timeout",
        "help": "Timeout in milliseconds for hosted MCP requests.",
        "advanced": true
      }
    }
  },
  "runtimeRequirements": {
    "bins": [
      "node"
    ],
    "env": [
      "SOCIAL_MEDIA_MCP_API_KEY"
    ],
    "primaryEnv": "SOCIAL_MEDIA_MCP_API_KEY",
    "networkTargets": [
      "https://mcp.52choujiang.com"
    ]
  },
  "requires": {
    "bins": [
      "node"
    ],
    "env": [
      "SOCIAL_MEDIA_MCP_API_KEY"
    ]
  },
  "primaryEnv": "SOCIAL_MEDIA_MCP_API_KEY",
  "networkTargets": [
    "https://mcp.52choujiang.com"
  ],
  "metadata": {
    "xhs-insights": {
      "requires": {
        "bins": [
          "node"
        ],
        "env": [
          "SOCIAL_MEDIA_MCP_API_KEY"
        ]
      },
      "primaryEnv": "SOCIAL_MEDIA_MCP_API_KEY",
      "networkTargets": [
        "https://mcp.52choujiang.com"
      ]
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "files": [
    "openclaw.plugin.json",
    "index.js",
    "README.md",
    "LICENSE"
  ]
}
