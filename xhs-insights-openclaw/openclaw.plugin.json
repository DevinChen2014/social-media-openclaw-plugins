{
  "id": "xhs-insights-openclaw-plugin",
  "name": "Xiaohongshu RedNote XHS Insights MCP",
  "description": "Social media research and marketing research for Xiaohongshu, XHS, RedNote, and 小红书: search notes, analyze comments, read note details, replies, creator profiles, and creator posts through a hosted read-only MCP service.",
  "version": "0.1.11",
  "providers": ["xhs-insights"],
  "providerAuthEnvVars": {
    "xhs-insights": ["SOCIAL_MEDIA_MCP_API_KEY"]
  },
  "providerAuthChoices": [
    {
      "provider": "xhs-insights",
      "method": "api-key",
      "choiceId": "social-media-mcp-api-key",
      "choiceLabel": "Social Media MCP API Key",
      "choiceHint": "Used only to authorize requests to the hosted XHS Insights MCP service.",
      "groupId": "social-media-insights",
      "groupLabel": "Social Media Insights",
      "optionKey": "socialMediaMcpApiKey",
      "cliFlag": "--social-media-mcp-api-key",
      "cliOption": "--social-media-mcp-api-key <key>",
      "cliDescription": "SOCIAL_MEDIA_MCP_API_KEY used by the hosted MCP service.",
      "onboardingScopes": ["social-media-research"],
      "assistantPriority": 0
    }
  ],
  "activation": {
    "onStartup": false,
    "onCapabilities": ["tool"]
  },
  "runtimeRequirements": {
    "bins": ["node"],
    "env": ["SOCIAL_MEDIA_MCP_API_KEY"],
    "primaryEnv": "SOCIAL_MEDIA_MCP_API_KEY",
    "networkTargets": ["https://mcp.52choujiang.com"]
  },
  "metadata": {
    "xhs-insights": {
      "requires": {
        "bins": ["node"],
        "env": ["SOCIAL_MEDIA_MCP_API_KEY"]
      },
      "primaryEnv": "SOCIAL_MEDIA_MCP_API_KEY",
      "networkTargets": ["https://mcp.52choujiang.com"]
    }
  },
  "requires": {
    "bins": ["node"],
    "env": ["SOCIAL_MEDIA_MCP_API_KEY"]
  },
  "primaryEnv": "SOCIAL_MEDIA_MCP_API_KEY",
  "networkTargets": ["https://mcp.52choujiang.com"],
  "environment": {
    "binaries": ["node"],
    "externalServices": [
      {
        "name": "mcp.52choujiang.com"
      }
    ]
  },
  "contracts": {
    "tools": [
      "xhs-insights__xhs_search_notes",
      "xhs-insights__xhs_get_note_detail_by_note_url",
      "xhs-insights__xhs_get_note_detail_by_note_id",
      "xhs-insights__xhs_get_note_comments_by_note_id",
      "xhs-insights__xhs_get_note_comments_by_note_url",
      "xhs-insights__xhs_get_note_sub_comments_by_comment_id",
      "xhs-insights__xhs_get_user_info_by_user_id",
      "xhs-insights__xhs_get_user_info_by_profile_url",
      "xhs-insights__xhs_get_user_posted_notes_by_user_id",
      "xhs-insights__xhs_get_user_posted_notes_by_profile_url"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "connectionTimeoutMs": {
        "type": "integer",
        "default": 30000,
        "minimum": 1000,
        "maximum": 120000,
        "description": "Timeout in milliseconds for remote MCP HTTP requests."
      }
    }
  },
  "configUiHints": {
    "connectionTimeoutMs": {
      "label": "Connection timeout",
      "help": "Timeout in milliseconds for hosted MCP requests.",
      "advanced": true
    }
  },
  "uiHints": {
    "connectionTimeoutMs": {
      "label": "Connection timeout",
      "help": "Timeout in milliseconds for hosted MCP requests.",
      "advanced": true
    }
  }
}
